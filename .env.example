# ──────────────────────────────────────────────────
# Hydra DB — OpenClaw Plugin
# Copy to .env and fill in your credentials.
# ──────────────────────────────────────────────────

# (Required) Your Hydra API key — obtain from https://app.hydradb.com
HYDRADB_API_KEY=

# (Required) Your Hydra database (tenant) identifier — shown in the Hydra dashboard
HYDRADB_DATABASE=

# (Optional) Collection (sub-tenant) for data partitioning within your database.
# Defaults to "hydra-openclaw-plugin".
# HYDRADB_COLLECTION=

# (Optional) Override the API base URL. Defaults to https://api.hydradb.com.
# HYDRADB_BASE_URL=

# ── Deprecated aliases (still honoured, but emit a one-time warning) ──
# HYDRA_OPENCLAW_API_KEY=
# HYDRA_OPENCLAW_TENANT_ID=
